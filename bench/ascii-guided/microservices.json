{
  "diagram": {
    "title": "Microservices Architecture",
    "boxes": [
      { "id": "gw", "label": "API Gateway", "kind": "service", "properties": { "sublabel": "Kong / Nginx" } },
      { "id": "auth", "label": "Auth Service", "kind": "service" },
      { "id": "users", "label": "User Service", "kind": "service" },
      { "id": "orders", "label": "Order Service", "kind": "service" },
      { "id": "notify", "label": "Notification", "kind": "service" },
      { "id": "db-users", "label": "Users DB", "kind": "datastore" },
      { "id": "db-orders", "label": "Orders DB", "kind": "datastore" },
      { "id": "queue", "label": "Message Queue", "properties": { "shape": "pill" } }
    ],
    "grid": [
      [null,       "gw",       null],
      ["auth",     "users",    "orders"],
      ["db-users", "queue",    "db-orders"],
      [null,       "notify",   null]
    ],
    "connectors": [
      { "from": "gw", "to": "auth", "arrow": "-->" },
      { "from": "gw", "to": "users", "arrow": "-->" },
      { "from": "gw", "to": "orders", "arrow": "-->" },
      { "from": "users", "to": "db-users", "arrow": "-->" },
      { "from": "orders", "to": "db-orders", "arrow": "-->" },
      { "from": "orders", "to": "queue", "arrow": "-->" },
      { "from": "queue", "to": "notify", "arrow": "-->", "label": "async" }
    ],
    "subgraphs": [
      {
        "id": "sg-backend",
        "label": "Backend Services",
        "childIds": ["auth", "users", "orders"]
      },
      {
        "id": "sg-data",
        "label": "Data Layer",
        "childIds": ["db-users", "queue", "db-orders"]
      }
    ],
    "direction": "TB",
    "theme": "dark",
    "spacing": "spacious"
  }
