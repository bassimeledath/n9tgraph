{
  "diagram": {
    "title": "E-Commerce Checkout Flow",
    "boxes": [
      { "id": "cart", "label": "Shopping Cart" },
      { "id": "auth", "label": "Login / Register", "properties": { "sublabel": "OAuth or email" } },
      { "id": "addr", "label": "Shipping Address" },
      { "id": "pay", "label": "Payment", "properties": { "sublabel": "Stripe integration" } },
      { "id": "confirm", "label": "Order Confirmation" },
      { "id": "email", "label": "Send Email", "kind": "service" },
      { "id": "inv", "label": "Inventory DB", "kind": "datastore" }
    ],
    "grid": [
      ["cart",    null,    null],
      ["auth",    null,    null],
      ["addr",    "pay",   null],
      ["confirm", "email", "inv"]
    ],
    "connectors": [
      { "from": "cart", "to": "auth", "arrow": "-->" },
      { "from": "auth", "to": "addr", "arrow": "-->" },
      { "from": "addr", "to": "pay", "arrow": "-->" },
      { "from": "pay", "to": "confirm", "arrow": "-->" },
      { "from": "confirm", "to": "email", "arrow": "-->" },
      { "from": "confirm", "to": "inv", "arrow": "-->", "label": "update stock" },
      { "from": "email", "to": "inv", "arrow": "-.->" }
    ],
    "subgraphs": [
      {
        "id": "sg-checkout",
        "label": "Checkout Pipeline",
        "childIds": ["addr", "pay", "confirm"]
      }
    ],
    "direction": "TB",
    "theme": "dark"
  }
}
