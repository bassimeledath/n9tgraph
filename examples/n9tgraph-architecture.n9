type flow
direction TB
spacing spacious

component "Input (.n9)" {fill: dotgrid}
component "PEG Parser"
component "Layout Engine" {fill: hero, sublabel: "Sugiyama layering"}
component "SVG Renderer" {fill: dotgrid}
external "Output (SVG / PNG)"

INPUT_N9 --> PEG_PARSER : parse
PEG_PARSER --> LAYOUT_ENGINE : AST
LAYOUT_ENGINE --> SVG_RENDERER : positioned nodes
SVG_RENDERER --> OUTPUT_SVG_PNG : render
